{
  "name": "alignment-forge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "manifests": "node scripts/generate-example-manifests.mjs",
    "manifests:check": "node scripts/generate-example-manifests.mjs --check",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "check": "npm run lint && npm run check:display && npm run build && npm test",
    "build:wasm": "RUSTFLAGS=\"-C target-feature=+simd128\" wasm-pack build src-tauri --release --target web --out-dir ../src/engine-wasm --out-name engine",
    "check:display": "esbuild scripts/check-display-helpers.ts --bundle --platform=node --format=cjs --outfile=scripts/.display-check.cjs --log-level=warning && node scripts/.display-check.cjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.12.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.1.0"
  }
}
